---
import type { CollectionEntry } from "astro:content";
import { slug, fmtUnit, fmtAmount } from "../lib";
interface Props { menus: CollectionEntry<"menus">[]; }
const { menus } = Astro.props;
---
{menus.map((m) => (
  <section class="menu-block" id={slug(m.data.title)} aria-labelledby={`h-${slug(m.data.title)}`}>
    <div class="wrap">
      <div class="menu-block__head" data-reveal-group>
        <span class="eyebrow">{m.data.page === "food" ? "Food" : "Drinks"}</span>
        <h2 id={`h-${slug(m.data.title)}`}>{m.data.title}</h2>
      </div>
      {m.data.sections.map((s) => (
        <div class="menu-section">
          <div class="menu-section__head" data-reveal>
            <h3>{s.title}</h3>
            {s.note && <p>{s.note}</p>}
          </div>
          <ul class="menu-items">
            {s.items.map((it) => (
              <li class="menu-item">
                <div class="menu-item__top">
                  <span class="menu-item__name">{it.name}</span>
                  {it.prices.length === 1 && (
                    <span class="menu-item__price">{fmtAmount(it.prices[0].amount)}{it.prices[0].unit ? ` · ${fmtUnit(it.prices[0].unit)}` : ""}</span>
                  )}
                </div>
                {it.description && <p class="menu-item__desc">{it.description}</p>}
                {it.prices.length > 1 && (
                  <p class="menu-item__prices">
                    {it.prices.map((p) => <span><span>{fmtUnit(p.unit)}</span> {fmtAmount(p.amount)}</span>)}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
      {m.data.note && <p class="advisory">{m.data.note}</p>}
    </div>
  </section>
))}

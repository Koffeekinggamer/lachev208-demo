---
import type { ImageMetadata } from "astro";
import Photo from "./Photo.astro";
interface Props { image: ImageMetadata; alt: string; eyebrow: string; title: string; position?: string }
const { image, alt, eyebrow, title, position = "50% 50%" } = Astro.props;
---
<section class="page-hero">
  <div class="hero__media" style={`--pos:${position}`}>
    <Photo src={image} alt={alt} sizes="100vw" eager />
  </div>
  <div class="wrap">
    <div class="page-hero__copy">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <slot />
    </div>
  </div>
</section>

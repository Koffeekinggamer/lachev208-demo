---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import MenuBoard from "../components/MenuBoard.astro";
import Photo from "../components/Photo.astro";
import { slug, site } from "../lib";
import hero from "../assets/photos/espresso-martini.jpg";
import patio from "../assets/photos/patio-table.jpg";
const menus = (await getCollection("menus", (m) => m.data.page === "drink")).sort((a, b) => a.data.order - b.data.order);
const count = menus.reduce((n, m) => n + m.data.sections.reduce((k, s) => k + s.items.length, 0), 0);
const ext = { target: "_blank", rel: "noopener" };
---
<Base title="Drink menu · Wine, cocktails & spirits · La Chev 208" description="Wine by the glass and bottle, house cocktails, bourbon, rye, scotch, beer, coffee and zero-proof drinks at La Chev 208 in Summerville, SC." current="drink">
  <PageHero image={hero} alt="Espresso martini with a crema top" eyebrow="Drink menu" title="Wine, cocktails & the bar" position="50% 55%">
    <p>{count} pours, from crisp whites and sparkling to a deep bourbon shelf.</p>
  </PageHero>
  <nav class="menu-nav" aria-label="Drink menus">
    <div class="wrap"><ul>{menus.map((m) => <li><a href={`#${slug(m.data.title)}`}>{m.data.title}</a></li>)}</ul></div>
  </nav>
  <MenuBoard menus={menus} />
  <section class="section section--surface" aria-labelledby="patio-h">
    <div class="wrap split">
      <div class="stack" data-reveal-group>
        <span class="eyebrow">Out back</span>
        <h2 id="patio-h">A glass on the patio</h2>
        <p class="muted">Our backyard is the easiest place in Summerville to let one glass become two.</p>
        <div class="btn-row"><a class="btn btn--solid" href={site.links.resy} {...ext}>Reserve<span class="sr-only"> on Resy (opens in a new tab)</span></a></div>
      </div>
      <div data-reveal><div class="frame frame--wide"><Photo src={patio} alt="Two plates on a backyard table under a red umbrella" sizes="(min-width: 900px) 45vw, 100vw" /></div></div>
    </div>
  </section>
</Base>

---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib";
import cormorant from "../assets/fonts/cormorant-garamond-latin-500-normal.woff2?url";
import jost from "../assets/fonts/jost-latin-400-normal.woff2?url";
interface Props { title: string; description: string; current?: string; jsonLd?: object }
const { title, description, current = "", jsonLd } = Astro.props;
const canonicalPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Concept preview: never index. Remove at launch. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7f3ec" />
    <link rel="icon" type="image/png" href={url("/favicon.png")} />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="La Chev 208" />
    <meta property="og:url" content={new URL(canonicalPath, Astro.site).href} />
    <link rel="preload" href={cormorant} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jost} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion");
      else document.documentElement.classList.add("motion", "reduce-motion");
      setTimeout(function () { document.documentElement.classList.add("reveal-failsafe"); }, 1500);
    </script>
    <slot name="head" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
